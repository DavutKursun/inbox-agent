# Copy to .env and fill in. Never commit .env. Keys go in this file only — never in a chat.

LLM_PROVIDER=openai_compat        # openai_compat | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1     # or https://api.cerebras.ai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=qwen/qwen3.8-27b        # default since M3 step 0; openai/gpt-oss-120b finishes only via the text fallback (DESIGN.md)
LLM_REASONING_EFFORT=low          # sent when non-empty (gpt-oss and qwen3 on Groq accept it); leave empty for others

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Agent limits
MAX_TURNS=8                       # not the spec's 6: gpt-oss-120b on Groq makes one tool call per turn (DESIGN.md)
MAX_EMAIL_CHARS=2000
MAX_DAILY_USD=1
MAX_DAILY_CALLS=150               # provider calls (agent steps) per day, all threads together

# Live integrations (Milestone 5) — off by default; fakes are used
CALENDAR_MODE=fake                # fake | google (live mode: run `python -m integrations.gcal auth` once)
GCAL_CALENDAR_ID=primary          # use a dedicated test calendar in google mode
GMAIL_MODE=off                    # off | drafts
